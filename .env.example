# --- Docker / host layout -----------------------------------------------------
# Host path of the T-Pot CE Hive install (mounted into the containers at /tpot)
TPOT_HOST_DIR=

# UID/GID the containers run as: must be able to write to $TPOT_HOST_DIR/data/nginx/conf
# and $TPOT_HOST_DIR/.env (check with `stat -c '%u:%g' $TPOT_HOST_DIR`).
PUID=1000
PGID=1000
# Extra group for T-Pot files (optional; default 2000 = T-Pot's "tpot" group)
TPOT_GID=2000

# Published web port. T-Pot's nginx runs on its own Docker network and proxies /sensors/ to this
# address, so it must be the host's Docker bridge IP (docker0), not 127.0.0.1. tpot-expansion-pack.sh
# sets it for you. Not reachable from outside the host.
WEB_BIND=172.17.0.1
WEB_PORT=8880

# Addresses/CIDRs (comma-separated) allowed to fetch /edl/sensors.txt without a login: your firewall.
# Empty means only the Hive itself. Applied by tpot-expansion-pack.sh; re-run it after changing this.
EDL_ALLOW=

# Directory with the secrets, mounted read-only at /secrets:
#   do_token     DigitalOcean API token (read + write)
#   gcp-sa.json  GCP service account key (Compute Admin + Service Account User)
#   ssh_key      private key Ansible uses to configure and check sensors
#   ssh_key.pub  matching public key, injected into new droplets
SECRETS_HOST_DIR=./secrets

# --- Cloud credentials --------------------------------------------------------
# Secrets are files in SECRETS_HOST_DIR, not variables here (variables are visible in
# `docker inspect`); tpot-expansion-pack.sh creates them with mode 600:
#   do_token     DigitalOcean Personal Access Token (Read & Write):
#                https://cloud.digitalocean.com/account/api/tokens
#   gcp-sa.json  GCP service account key (see below)

# GCP project id (can also be saved from Admin, which stores it in the database). Auth is the
# service account key at $SECRETS_HOST_DIR/gcp-sa.json (Compute Admin role), not a token here.
GCP_PROJECT_ID=

# --- Hive ---------------------------------------------------------------------
# Public IP or FQDN of this T-Pot Hive (auto-detected if blank)
TPOT_HIVE_IP=

# How long a deploy waits for the firewall to admit a new sensor to the Hive before warning (seconds)
HIVE_ADMIT_WAIT_SECONDS=480
