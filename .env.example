# --- Docker / host layout -----------------------------------------------------
# Host path of the T-Pot CE Hive install (mounted into the containers at /tpot)
TPOT_HOST_DIR=

# UID/GID the containers run as: must be able to write to $TPOT_HOST_DIR/data/nginx/conf
# and $TPOT_HOST_DIR/.env (check with `stat -c '%u:%g' $TPOT_HOST_DIR`).
PUID=1000
PGID=1000
# Extra group for T-Pot files (optional; default 2000 = T-Pot's "tpot" group)
TPOT_GID=2000

# Published web port (loopback by default; T-Pot's nginx proxies /sensors/ to it)
WEB_BIND=127.0.0.1
WEB_PORT=8880

# Directory with optional secrets, mounted read-only at /secrets:
#   gcp-sa.json  GCP service account key (Compute Admin + Service Account User)
#   ssh_key      private key Ansible uses to configure and check sensors
#   ssh_key.pub  matching public key, injected into new droplets
SECRETS_HOST_DIR=./secrets

# --- Cloud credentials --------------------------------------------------------
# DigitalOcean Personal Access Token (Read & Write):
# https://cloud.digitalocean.com/account/api/tokens
DO_TOKEN=

# GCP project id (can also be saved from Admin, which stores it in the database). Auth is the
# service account key at $SECRETS_HOST_DIR/gcp-sa.json (Compute Admin role), not a token here.
GCP_PROJECT_ID=

# --- Hive ---------------------------------------------------------------------
# Public IP or FQDN of this T-Pot Hive (auto-detected if blank)
TPOT_HIVE_IP=

# How long a deploy waits for the firewall to admit a new sensor to the Hive before warning (seconds)
HIVE_ADMIT_WAIT_SECONDS=480
